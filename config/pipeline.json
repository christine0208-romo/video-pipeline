{
  "spec": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "dataDir": "data",
  "outDir": "out",
  "runtime": {
    "publicDir": "public",
    "cacheDir": ".cache/video-pipeline",
    "tempDir": ".cache/video-pipeline/tmp",
    "releaseDir": "release"
  },
  "tools": {
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe"
  },
  "assets": {
    "roots": [
      "assets"
    ]
  },
  "footage": {
    "roots": [
      "footage"
    ],
    "extensions": [
      ".mp4",
      ".mov",
      ".m4v",
      ".mkv",
      ".avi",
      ".webm",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".avif"
    ],
    "exclude": [
      "node_modules",
      ".git",
      "$RECYCLE.BIN",
      "System Volume Information",
      ".cache"
    ],
    "cropDetect": true,
    "sceneSplit": {
      "enabled": true,
      "threshold": 0.32,
      "minShot": 1.2,
      "pad": 0.15
    },
    "thumbs": {
      "enabled": true,
      "count": 3,
      "width": 480
    }
  },
  "mix": {
    "duration": 30,
    "outputs": 1,
    "seed": 20261108,
    "maxPerAsset": 3,
    "maxPerCreative": 2,
    "minGap": 2,
    "generatedRatio": 0.3,
    "shotLength": {
      "min": 1.4,
      "max": 2.6
    },
    "beatJitter": 0.15,
    "minShots": 4,
    "maxShots": 12,
    "allowDraft": false,
    "allowLowQuality": false,
    "perceptualDedupe": true,
    "requireWorkAsset": false,
    "bpm": null,
    "music": {
      "mode": "auto",
      "mood": "calm",
      "energy": "medium",
      "volume": 0.6,
      "fadeIn": 0.8,
      "fadeOut": 1,
      "duckTo": 0.22
    },
    "sfx": {
      "enabled": true,
      "volume": 1.4,
      "duckMusic": true,
      "maxPerOutput": 16,
      "minGap": 0.05
    },
    "beats": [
      {
        "role": "hook",
        "ratio": 0.14
      },
      {
        "role": "build",
        "ratio": 0.26
      },
      {
        "role": "proof",
        "ratio": 0.3
      },
      {
        "role": "turn",
        "ratio": 0.18
      },
      {
        "role": "close",
        "ratio": 0.12
      }
    ]
  },
  "fission": {
    "works": 1,
    "seed": 20261108,
    "duration": null,
    "generateAssets": false,
    "assetsPerLayer": {
      "scene": 1,
      "overlay": 2,
      "transition": 2
    }
  },
  "shared": {
    "root": "shared"
  },
  "creative": {
    "root": "creative",
    "maxAssetsPerVariant": 24,
    "autoQuality": true,
    "formats": [
      "mp4",
      "webm-alpha"
    ],
    "pool": "all"
  },
  "quality": {
    "autoAnalyze": true,
    "sampleFrames": 8,
    "phashSize": 32,
    "alphaSampleWidth": 96,
    "alphaThreshold": 4,
    "minAlphaCoverage": 0.001,
    "faintAlphaCoverage": 0.01,
    "minMotionEnergy": 0.00002,
    "minContrast": 0.008,
    "loopDistance": 12,
    "settleMotion": 0.004,
    "clearAlpha": 0.02,
    "clusterDistance": 12,
    "similarityThreshold": 0.86,
    "maxSimilarityPairs": 24
  }
}
