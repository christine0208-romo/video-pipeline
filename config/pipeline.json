    "sidecars": [
      "tags.json"
    ],
    "cropDetect": true,
    "sceneSplit": {
      "enabled": true,
      "threshold": 0.32,
      "minShot": 1.2,
      "pad": 0.15
    },
    "thumbs": {
      "enabled": true,
      "count": 3,
      "width": 480
    }
  },
  "generate": {
    "presets": [
      "platform-orbit",
      "social-constellation",
      "network-universe",
      "icon-morph",
      "ui-mock",
      "kinetic-grid"
    ],
    "variantsPerPreset": 2,
    "duration": 3,
    "formats": [
      "mp4",
      "webm-alpha"
    ]
  },
  "mix": {
    "duration": 30,
    "outputs": 1,
    "seed": 20261108,
    "maxPerAsset": 3,
    "minGap": 2,
    "generatedRatio": 0.3,
    "music": null,
    "beats": [
      {
        "role": "hook",
        "ratio": 0.14
      },
      {
        "role": "build",
        "ratio": 0.26
      },
      {
        "role": "proof",
        "ratio": 0.3
      },
      {
        "role": "turn",
        "ratio": 0.18
      },
      {
        "role": "close",
        "ratio": 0.12
      }
    ]
  }
