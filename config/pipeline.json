{
  "spec": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "dataDir": "data",
  "outDir": "out",
  "footage": {
    "roots": [
      "D:/Files/AI_Vedio/1_素材库/vedio"
    ],
    "extensions": [
      ".mp4",
      ".mov",
      ".m4v",
      ".mkv",
      ".avi",
      ".webm",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".avif"
    ],
    "exclude": [
      "node_modules",
      ".git",
      "$RECYCLE.BIN",
      "System Volume Information",
      ".cache"
