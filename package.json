{
  "name": "video-pipeline",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone footage scan + generated motion assets + non-repeating vertical mix pipeline.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node tools/init-creative.mjs",
    "doctor": "node tools/doctor.mjs",
    "all": "node run.mjs all",
    "scan": "node run.mjs scan",
    "creative": "node run.mjs creative",
    "creative:init": "node tools/init-creative.mjs",
    "creative:registry": "node run.mjs creative registry",
    "shared:init": "node run.mjs shared init",
    "shared:status": "node run.mjs shared status",
    "shared:validate": "node run.mjs shared validate",
    "sync": "node run.mjs sync",
    "assets:check": "node tools/assets.mjs check",
    "assets:verify": "node tools/assets.mjs check --verify",
    "assets:scan": "node tools/assets.mjs scan",
    "assets:fetch": "node tools/assets.mjs fetch",
    "quality": "node run.mjs quality",
    "mix": "node run.mjs mix",
    "fission": "node run.mjs fission",
    "stills": "node run.mjs stills",
    "check": "node tools/check.mjs",
    "check:edl": "node modules/mix/index.mjs --check-only",
    "cache": "node run.mjs cache",
    "reindex": "node run.mjs reindex",
    "runtime": "node run.mjs runtime",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio src/index.ts",
    "workbench": "node workbench/server.mjs",
    "workbench:open": "node workbench/server.mjs --open"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "lucide-react": "1.69.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
